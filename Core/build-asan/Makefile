	$(MAKE) $(MAKESILENT) -f CMakeFiles/savetest.dir/build.make CMakeFiles/savetest.dir/tools/savetest.cpp.s
.PHONY : tools/savetest.cpp.s

tools/songrender.o: tools/songrender.cpp.o
.PHONY : tools/songrender.o

# target to build an object file
tools/songrender.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/songrender.dir/build.make CMakeFiles/songrender.dir/tools/songrender.cpp.o
.PHONY : tools/songrender.cpp.o

tools/songrender.i: tools/songrender.cpp.i
.PHONY : tools/songrender.i

# target to preprocess a source file
tools/songrender.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/songrender.dir/build.make CMakeFiles/songrender.dir/tools/songrender.cpp.i
.PHONY : tools/songrender.cpp.i

tools/songrender.s: tools/songrender.cpp.s
.PHONY : tools/songrender.s

# target to generate assembly for a file
tools/songrender.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/songrender.dir/build.make CMakeFiles/songrender.dir/tools/songrender.cpp.s
.PHONY : tools/songrender.cpp.s

